#!/data/data/com.termux/files/usr/bin/bash

# OmniRush Android/Termux launcher
#
# Run this from a Termux project directory:
#   omni
#
# It mounts the current Termux directory as /workspace inside Debian,
# loads the Linux ARM64 Node.js installation from NVM, and starts OmniRush.

set -e

PROJECT="$PWD"

if ! command -v proot-distro >/dev/null 2>&1; then
  echo "Error: proot-distro is not installed."
  echo "Install it with: pkg install proot-distro -y"
  exit 1
fi

proot-distro login debian \
  --bind "$PROJECT:/workspace" \
  -- bash -lc '
    export NVM_DIR="/root/.nvm"

    if [ ! -s "$NVM_DIR/nvm.sh" ]; then
      echo "Error: NVM was not found inside Debian at $NVM_DIR/nvm.sh"
      exit 1
    fi

    . "$NVM_DIR/nvm.sh"

    if ! command -v omnirush >/dev/null 2>&1; then
      echo "Error: OmniRush is not installed inside Debian."
      echo "Install it with: npm i -g omnirush@latest"
      exit 1
    fi

    cd /workspace
    exec omnirush
  '
